msgstr ""
"Si se marca, los contactos buscados serán actualizados con los datos del "
"cliente de la petición restantes"

#. module: ecommerce_connector
#: model:ir.model.fields,help:ecommerce_connector.field_ecommerce_connection__has_custom_precision_digits
msgid ""
