<odoo noupdate="True">
    <record id="group_call_runner" model="res.groups">
        <field name="name">Ecommerce Connector Call Runner</field>
        <field name="category_id" ref="base.module_category_hidden" />
        <field
            name="implied_ids"
            eval="[
            (4, ref('sales_team.group_sale_salesman_all_leads')),
            (4, ref('account.group_account_invoice')),
            (4, ref('product.group_product_manager')),
            (4, ref('base.group_partner_manager'))
        ]"
        />
    </record>

    <record id="group_debug" model="res.groups">
        <field name="name">Can Enable the Ecommerce Connector Debug Mode</field>
        <field name="category_id" ref="base.module_category_hidden" />
        <field
            name="users"
            eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
        />
    </record>
</odoo>
