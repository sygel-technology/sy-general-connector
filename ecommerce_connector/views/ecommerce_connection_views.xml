<odoo>

    <record id="ecommerce_connection_view_form" model="ir.ui.view">
        <field name="model">ecommerce.connection</field>
        <field name="inherit_id" ref="base_connector.ecommerce_connection_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='general']" position="after">
                <group string="Sale Options">
                    <field name="create_invoice" />
                    <field name="validate_invoice" invisible="not create_invoice"/>
                    <field name="duplicate_invoice_name" />
                    <field name="use_odoo_so_sequence" />
                    <field name="create_products_single_company" />
                    <field name="update_contacts" />
                    <field name="shipping_address_search_rule" />
                    <field name="invoice_address_search_rule" />
                </group>
            </xpath>
        </field>
    </record>

</odoo>
